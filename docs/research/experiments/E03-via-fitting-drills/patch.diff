+  /**
+   * The drill pieces are cut from the page with obstacle shapes compensated for traces, so the
+   * centre of gravity of a piece can lie closer to an obstacle than a via fits. In a narrow pocket
+   * that holds every candidate of the pocket outside the smaller region where a via fits, and the
+   * pocket cannot be left through a via. When the centre of gravity of {@code piece} lies inside an
+   * obstacle enlarged by the via compensation, adds a drill at the centre of gravity of each part
+   * of the piece outside the enlarged obstacles.
+   */
+  private void addViaFittingDrills(
+      AutorouteEngine autorouteEngine,
+      TileShape piece,
+      Point centreOfGravity,
+      TileShape[] viaHoles) {
+    long statStart = VIA_FITTING_STATS ? System.nanoTime() : 0;
+    TileShape[] fittingParts =
+        viaFittingParts(piece, centreOfGravity, viaHoles, autorouteEngine.stoppableThread);
+    int added = 0;
+    if (fittingParts != null) {
+      for (TileShape part : fittingParts) {
+        Point location = part.centreOfGravity().round();
+        if (!part.contains(location)) {
+          continue;
+        }
+        ExpansionDrill drill =
+            new ExpansionDrill(part, location, 0, this.board.getLayerCount() - 1);
+        if (drill.calculateExpansionRooms(autorouteEngine)) {
+          this.drills.add(drill);
+          added++;
+        }
+      }
+    }
+    if (VIA_FITTING_STATS) {
+      STAT_PIECES.increment();
+      if (fittingParts != null) {
+        STAT_BLOCKED_PIECES.increment();
+      }
+      STAT_EXTRA_DRILLS.add(added);
+      STAT_NANOS.add(System.nanoTime() - statStart);
+    }
+  }
+
+  /**
+   * Returns the convex parts of {@code piece} outside {@code viaHoles}, or null if {@code
+   * centreOfGravity} lies outside every via hole (the centre drill of the piece fits a via then) or
+   * the split was stopped. Holes whose bounding box misses the piece's bounding box enlarged by one
+   * unit (against rounding of the box corners) are skipped before the exact intersection; that does
+   * not change the result.
+   */
+  static TileShape[] viaFittingParts(
+      TileShape piece, Point centreOfGravity, TileShape[] viaHoles, Stoppable stoppable) {
+    IntBox pieceBox = piece.boundingBox().offset(1);
+    Collection<TileShape> cutouts = new LinkedList<>();
+    boolean centreBlocked = false;
+    for (TileShape viaHole : viaHoles) {
+      if (!pieceBox.intersects(viaHole.boundingBox())) {
+        continue;
+      }
+      TileShape cutout = viaHole.intersection(piece);
+      if (cutout.dimension() == 2) {
+        cutouts.add(cutout);
+        centreBlocked |= cutout.containsInside(centreOfGravity);
+      }
+    }
+    if (!centreBlocked) {
+      return null;
+    }
+    return new PolylineArea(piece, cutouts.toArray(new TileShape[0])).splitToConvex(stoppable);
+  }
+
+  /** Whether the counters of experiment E03 are enabled for this process. */
+  public static boolean viaFittingStatsEnabled() {
+    return VIA_FITTING_STATS;
+  }
+
+  /** The counters of experiment E03 for all drill pages of this process, as one log line. */
+  public static String viaFittingStatsSummary() {
+    return String.format(
+        Locale.US,
+        "Experiment %s=%s: %d drill pages computed, %d pieces checked, %d with a blocked centre,"
+            + " %d extra drills, %.2f s in the via-fitting code",
+        VIA_FITTING_DRILLS_PROPERTY,
+        VIA_FITTING_DRILLS,
+        STAT_PAGES.sum(),
+        STAT_PIECES.sum(),
+        STAT_BLOCKED_PIECES.sum(),
+        STAT_EXTRA_DRILLS.sum(),
+        STAT_NANOS.sum() / 1e9);
+  }
+
+  /**
+   * The obstacles of the page as in {@link #getDrills}, enlarged by the radius and the clearance
+   * compensation of the smallest via the net may use, or null if the net has no via.
+   */
+  private TileShape[] viaHoles(AutorouteEngine autorouteEngine, boolean attachSmd) {
+    double offset = viaCompensation();
+    if (offset <= 0) {
+      return null;
+    }
+    ShapeSearchTree searchTree = autorouteEngine.autorouteSearchTree;
+    Collection<TreeEntry> overlaps = new LinkedList<>();
+    searchTree.overlappingTreeEntries(this.shape.offset(Math.ceil(offset)), -1, overlaps);
+    Collection<TileShape> result = new LinkedList<>();
+    for (TreeEntry currentEntry : overlaps) {
+      if (!(currentEntry.object instanceof Item currentItem)
+          || currentItem.isDrillable(this.netNumber)) {
+        continue;
+      }
+      if (currentItem instanceof Pin pin
+          && attachSmd
+          && pin.drillAllowed()
+          && pin.containsNet(this.netNumber)) {
+        continue;
+      }
+      TileShape obstacleShape =
+          currentItem.getTreeShape(searchTree, currentEntry.shapeIndexInObject);
+      result.add((TileShape) obstacleShape.enlarge(offset));
+    }
+    return result.toArray(new TileShape[0]);
+  }
+
+  private double viaCompensation() {
+    Net net = this.board.rules.nets.get(this.netNumber);
+    ViaRule viaRule =
+        net == null || net.getNetClass() == null ? null : net.getNetClass().getViaRule();
+    if (viaRule == null) {
+      return 0;
+    }
+    double result = Double.MAX_VALUE;
+    for (int i = 0; i < viaRule.viaCount(); i++) {
+      ViaInfo viaInfo = viaRule.getVia(i);
+      Padstack padstack = viaInfo.getPadstack();
+      double radius = 0;
+      for (int layer = padstack.fromLayer(); layer <= padstack.toLayer(); layer++) {
+        ConvexShape shape = padstack.getShape(layer);
+        double layerRadius =
+            (shape == null ? 0 : 0.5 * shape.maxWidth())
+                + this.board.rules.clearanceMatrix.clearanceCompensationValue(
+                    viaInfo.getClearanceClassIndex(), layer);
+        radius = Math.max(radius, layerRadius);
+      }
+      result = Math.min(result, radius);
+    }
+    return result == Double.MAX_VALUE ? 0 : result;
+  }
