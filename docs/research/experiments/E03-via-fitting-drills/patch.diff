+package app.freerouting.autoroute.drill;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import app.freerouting.geometry.planar.IntBox;
+import app.freerouting.geometry.planar.IntPoint;
+import app.freerouting.geometry.planar.Point;
+import app.freerouting.geometry.planar.TileShape;
+import org.junit.jupiter.api.Test;
+
+class DrillPageViaFittingTest {
+
+  private static final IntBox PIECE = new IntBox(0, 0, 1000, 100);
+  private static final Point CENTRE = new IntPoint(500, 50);
+
+  @Test
+  void viaFittingDrillsAreOffByDefault() {
+    assertEquals(
+        Boolean.getBoolean(DrillPage.VIA_FITTING_DRILLS_PROPERTY), DrillPage.VIA_FITTING_DRILLS);
+  }
+
+  @Test
+  void aBlockedCentreGivesThePartsOutsideTheViaHoles() {
+    IntBox hole = new IntBox(400, -50, 600, 150);
+
+    TileShape[] parts = DrillPage.viaFittingParts(PIECE, CENTRE, new TileShape[] {hole}, null);
+
+    assertNotNull(parts);
+    assertTrue(parts.length >= 2, "The hole splits the piece into a left and a right part");
+    double area = 0;
+    for (TileShape part : parts) {
+      Point location = part.centreOfGravity().round();
+      assertTrue(PIECE.contains(location), "A via-fitting location lies inside the piece");
+      assertFalse(hole.containsInside(location), "A via-fitting location lies outside the hole");
+      assertFalse(part.containsInside(CENTRE), "No part holds the blocked centre");
+      area += part.area();
+    }
+    assertEquals(800 * 100, area, 1e-6, "The parts cover the piece outside the hole");
+  }
+
+  @Test
+  void aFreeCentreGivesNoExtraParts() {
+    IntBox hole = new IntBox(-50, -50, 100, 150);
+
+    assertNull(DrillPage.viaFittingParts(PIECE, CENTRE, new TileShape[] {hole}, null));
+  }
+
+  @Test
+  void holesAwayFromThePieceAreIgnored() {
+    IntBox farHole = new IntBox(5000, 5000, 6000, 6000);
+
+    assertNull(DrillPage.viaFittingParts(PIECE, CENTRE, new TileShape[] {farHole}, null));
+    assertNull(DrillPage.viaFittingParts(PIECE, CENTRE, new TileShape[0], null));
+  }
+}
