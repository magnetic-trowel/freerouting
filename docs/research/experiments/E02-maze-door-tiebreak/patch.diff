--- /dev/null
+++ b/src/main/java/app/freerouting/autoroute/maze/MazeTieBreak.java
@@ -0,0 +1,123 @@
+package app.freerouting.autoroute.maze;
+
+import java.util.Locale;
+import java.util.NavigableSet;
+import java.util.concurrent.atomic.LongAdder;
+
+/**
+ * Experiment switch for the last tie-break of the maze expansion list (experiment E02).
+ *
+ * <p>{@link MazeListElement#compareTo} orders by sorting value, expansion value, door id and door
+ * section. Door ids combine room ids by hashing, so two different doors can share one; at equal
+ * costs the expansion set then holds only the first of them. With the property {@code
+ * freerouting.exp.maze_tiebreak=insertion} each element gets its insertion number as the last
+ * tie-break, so such doors both stay in the list. The default {@code legacy} leaves every insertion
+ * number at 0, which keeps the old order and the old drops.
+ *
+ * <p>With {@code -Dfreerouting.exp.maze_tiebreak_stats=true} the process counts, for every element
+ * added to an expansion list, whether the list already held an element with equal legacy keys of
+ * the same or of a different door; see {@link #statsSummary()}.
+ */
+public final class MazeTieBreak {
+
+  /** System property that selects the tie-break: {@code legacy} (default) or {@code insertion}. */
+  public static final String PROPERTY = "freerouting.exp.maze_tiebreak";
+
+  /** System property that enables the tie counters. */
+  public static final String STATS_PROPERTY = "freerouting.exp.maze_tiebreak_stats";
+
+  static final boolean INSERTION_ORDER =
+      "insertion".equalsIgnoreCase(System.getProperty(PROPERTY, "legacy").trim());
+
+  static final boolean STATS = Boolean.getBoolean(STATS_PROPERTY);
+
+  private static final LongAdder TOTAL_ADDS = new LongAdder();
+  private static final LongAdder TOTAL_SAME_DOOR_TIES = new LongAdder();
+  private static final LongAdder TOTAL_DISTINCT_DOOR_TIES = new LongAdder();
+  private static final LongAdder TOTAL_DISTINCT_CLASS_TIES = new LongAdder();
+
+  private final boolean insertionOrder;
+  private final boolean stats;
+  private long nextInsertionNo = 1;
+
+  /** Elements offered to the list since its creation (only counted with stats). */
+  long adds;
+
+  /** Adds that tied with an element of the same door object (benign duplicates). */
+  long sameDoorTies;
+
+  /** Adds that tied with an element of a different door object (dropped by the legacy order). */
+  long distinctDoorTies;
+
+  /** The subset of {@link #distinctDoorTies} where the two doors are of different classes. */
+  long distinctClassTies;
+
+  /** Creates the tie-break state of one expansion list, configured from the system properties. */
+  MazeTieBreak() {
+    this(INSERTION_ORDER, STATS);
+  }
+
+  MazeTieBreak(boolean insertionOrder, boolean stats) {
+    this.insertionOrder = insertionOrder;
+    this.stats = stats;
+  }
+
+  /** Whether the tie counters are enabled for this process. */
+  public static boolean statsEnabled() {
+    return STATS;
+  }
+
+  /** The tie counters of all expansion lists of this process, as one log line. */
+  public static String statsSummary() {
+    return String.format(
+        Locale.US,
+        "Experiment %s=%s: %d maze list adds, %d tied with an element of the same door, %d tied"
+            + " with an element of a different door with the same id (%d of them a door of"
+            + " another class)",
+        PROPERTY,
+        INSERTION_ORDER ? "insertion" : "legacy",
+        TOTAL_ADDS.sum(),
+        TOTAL_SAME_DOOR_TIES.sum(),
+        TOTAL_DISTINCT_DOOR_TIES.sum(),
+        TOTAL_DISTINCT_CLASS_TIES.sum());
+  }
+
+  /**
+   * Called by the expansion list just before {@code element} is added to {@code list}: counts ties
+   * if enabled and assigns the insertion number if the insertion order is selected. An element
+   * keeps the number of its first insertion.
+   */
+  void beforeAdd(NavigableSet<MazeListElement> list, MazeListElement element) {
+    if (stats) {
+      countTies(list, element);
+    }
+    if (insertionOrder && element.insertionNo == 0) {
+      element.insertionNo = nextInsertionNo++;
+    }
+  }
+
+  private void countTies(NavigableSet<MazeListElement> list, MazeListElement element) {
+    adds++;
+    TOTAL_ADDS.increment();
+    if (element.insertionNo != 0) {
+      return;
+    }
+    // Elements with equal legacy keys follow an element with insertion number 0 directly, and
+    // in the legacy order they compare equal to it, so the ceiling is the tied element if any.
+    MazeListElement tied = list.ceiling(element);
+    if (tied == null || tied.compareLegacyKeys(element) != 0) {
+      return;
+    }
+    if (tied.door == element.door) {
+      sameDoorTies++;
+      TOTAL_SAME_DOOR_TIES.increment();
+      return;
+    }
+    distinctDoorTies++;
+    TOTAL_DISTINCT_DOOR_TIES.increment();
+    if (tied.door.getClass() != element.door.getClass()) {
+      distinctClassTies++;
+      TOTAL_DISTINCT_CLASS_TIES.increment();
+    }
+  }
+}
