+  @Test
+  void legacyOrderKeepsOnlyTheFirstOfTwoDoorsWithTheSameIdAndCost() {
+    // Door ids are hash combinations of room ids, so two different doors can share one.
+    NavigableSet<MazeListElement> queue = new TreeSet<>();
+    MazeTieBreak tieBreak = new MazeTieBreak(false, true);
+    MazeListElement first = tiedElement(new TestDoor(7));
+    MazeListElement second = tiedElement(new TestDoor(7));
+
+    add(queue, tieBreak, first);
+    add(queue, tieBreak, second);
+
+    assertEquals(1, queue.size(), "The legacy order drops the second door");
+    assertSame(first, queue.first());
+    assertEquals(0, second.insertionNo, "The legacy order assigns no insertion numbers");
+    assertEquals(2, tieBreak.adds);
+    assertEquals(1, tieBreak.distinctDoorTies);
+    assertEquals(0, tieBreak.sameDoorTies);
+  }
+
+  @Test
+  void insertionOrderKeepsDistinctDoorsWithTheSameIdAndCost() {
+    NavigableSet<MazeListElement> queue = new TreeSet<>();
+    MazeTieBreak tieBreak = new MazeTieBreak(true, true);
+    MazeListElement first = tiedElement(new TestDoor(7));
+    MazeListElement second = tiedElement(new TestDoor(7));
+
+    add(queue, tieBreak, first);
+    add(queue, tieBreak, second);
+
+    assertEquals(2, queue.size(), "A door must not be dropped because its id collides");
+    assertSame(first, queue.first(), "Full ties are expanded in insertion order");
+    assertEquals(1, tieBreak.distinctDoorTies, "The tie is counted as in the legacy order");
+  }
+
+  @Test
+  void insertionOrderStillSortsByCostBeforeInsertion() {
+    NavigableSet<MazeListElement> queue = new TreeSet<>();
+    MazeTieBreak tieBreak = new MazeTieBreak(true, false);
+    MazeListElement expensive =
+        new MazeListElement(new TestDoor(1), 0, null, 0, 3.0, 9.0, null, null, false, null, false);
+    MazeListElement cheap = tiedElement(new TestDoor(2));
+
+    add(queue, tieBreak, expensive);
+    add(queue, tieBreak, cheap);
+
+    assertSame(cheap, queue.first());
+    assertEquals(0, tieBreak.adds, "Nothing is counted without stats");
+  }
+
+  @Test
+  void sameDoorTiesAreCountedSeparately() {
+    NavigableSet<MazeListElement> queue = new TreeSet<>();
+    MazeTieBreak tieBreak = new MazeTieBreak(false, true);
+    TestDoor door = new TestDoor(3);
+
+    add(queue, tieBreak, tiedElement(door));
+    add(queue, tieBreak, tiedElement(door));
+
+    assertEquals(1, tieBreak.sameDoorTies);
+    assertEquals(0, tieBreak.distinctDoorTies);
+  }
+
+  @Test
+  void anElementKeepsTheInsertionNumberOfItsFirstInsertion() {
+    NavigableSet<MazeListElement> queue = new TreeSet<>();
+    MazeTieBreak tieBreak = new MazeTieBreak(true, false);
+    MazeListElement element = tiedElement(new TestDoor(4));
+
+    add(queue, tieBreak, element);
+    queue.pollFirst();
+    add(queue, tieBreak, tiedElement(new TestDoor(5)));
+    add(queue, tieBreak, element);
+
+    assertEquals(1, element.insertionNo);
+  }
+
+  private static MazeListElement tiedElement(ExpandableObject door) {
+    return new MazeListElement(door, 0, null, 0, 3.0, 5.0, null, null, false, null, false);
+  }
+
+  private static void add(
+      NavigableSet<MazeListElement> queue, MazeTieBreak tieBreak, MazeListElement element) {
+    tieBreak.beforeAdd(queue, element);
+    queue.add(element);
+  }
+
