+package app.freerouting.autoroute.pipeline;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertInstanceOf;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import app.freerouting.board.facade.RoutingBoard;
+import app.freerouting.board.model.items.Pin;
+import app.freerouting.board.model.items.Via;
+import app.freerouting.geometry.planar.FloatPoint;
+import app.freerouting.io.BoardReadResult;
+import app.freerouting.io.specctra.DsnReader;
+import java.io.FileInputStream;
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.EnumMap;
+import java.util.List;
+import java.util.Map;
+import org.junit.jupiter.api.Test;
+
+class DenseEscapeTest {
+
+  @Test
+  void classifiesTheLqfpPinsIntoFourSidesOfSixteen() throws IOException {
+    RoutingBoard board = loadCaniot();
+    List<Pin> u1 = new ArrayList<>();
+    for (Pin pin : board.getPins()) {
+      if ("U1".equals(board.components.get(pin.getComponentId()).name)) {
+        u1.add(pin);
+      }
+    }
+    assertEquals(64, u1.size());
+    List<FloatPoint> centres = new ArrayList<>();
+    for (Pin pin : u1) {
+      centres.add(pin.getCenter().toFloat());
+    }
+    List<DenseEscape.SidePin> sidePins = DenseEscape.classify(u1, DenseEscape.minPitch(centres));
+    assertNotNull(sidePins);
+    Map<DenseEscape.Side, Integer> counts = new EnumMap<>(DenseEscape.Side.class);
+    for (DenseEscape.SidePin sidePin : sidePins) {
+      counts.merge(sidePin.side(), 1, Integer::sum);
+    }
+    for (DenseEscape.Side side : DenseEscape.Side.values()) {
+      assertEquals(16, counts.get(side), side.name());
+    }
+  }
+
+  @Test
+  void escapesLeaveNoClearanceViolationAndAreRepeatable() throws IOException {
+    RoutingBoard first = loadCaniot();
+    DenseEscape.Summary summary = DenseEscape.run(first, null);
+    assertTrue(summary.components() >= 1);
+    assertTrue(summary.escaped() > 0, summary.toString());
+    for (Via via : first.getVias()) {
+      assertTrue(via.clearanceViolations().isEmpty(), "via " + via);
+    }
+    RoutingBoard second = loadCaniot();
+    assertEquals(summary, DenseEscape.run(second, null));
+    assertEquals(first.getVias().size(), second.getVias().size());
+  }
+
+  private static RoutingBoard loadCaniot() throws IOException {
+    try (FileInputStream in = new FileInputStream("fixtures/Issue269-caniot-tiny-arm.dsn")) {
+      BoardReadResult result = DsnReader.readBoard(in, null, null, "caniot");
+      assertInstanceOf(BoardReadResult.Success.class, result);
+      return (RoutingBoard) ((BoardReadResult.Success) result).board();
+    }
+  }
+}
