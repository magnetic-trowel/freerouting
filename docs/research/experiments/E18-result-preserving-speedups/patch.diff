+package app.freerouting.autoroute.maze;
+
+import java.util.Arrays;
+import java.util.HashSet;
+import java.util.Set;
+
+/**
+ * The maze search's expansion list: a binary heap with the behaviour of a {@code
+ * TreeSet<MazeListElement>} ordered by {@link MazeListElement#compareTo}.
+ *
+ * <p>A tree set rejects an element that compares equal to one it holds, and {@code pollFirst}
+ * returns the smallest element. Two elements compare equal exactly when their sorting value,
+ * expansion value, door id and door section are equal, so the queue keeps the key of every held
+ * element and rejects an element whose key is held. The held elements are then pairwise distinct
+ * under {@code compareTo}, so the heap minimum is the unique smallest element and the polling
+ * sequence is the tree set's. Insertion costs O(1) comparisons on average instead of O(log n).
+ */
+class MazeExpansionQueue {
+
+  private MazeListElement[] heap = new MazeListElement[64];
+  private int size;
+  private final Set<Key> heldKeys = new HashSet<>();
+
+  /** The fields that {@link MazeListElement#compareTo} compares; -0.0 is folded into 0.0. */
+  private record Key(double sortingValue, double expansionValue, int doorId, int sectionNo) {
+    static Key of(MazeListElement element) {
+      return new Key(
+          element.sortingValue + 0.0,
+          element.expansionValue + 0.0,
+          element.door.getId(),
+          element.sectionNoOfDoor);
+    }
+  }
+
+  /** Adds element unless an element comparing equal is held; returns whether it was added. */
+  public boolean add(MazeListElement element) {
+    if (!heldKeys.add(Key.of(element))) {
+      return false;
+    }
+    if (size == heap.length) {
+      heap = Arrays.copyOf(heap, 2 * size);
+    }
+    int index = size++;
+    while (index > 0) {
+      int parent = (index - 1) >>> 1;
+      MazeListElement parentElement = heap[parent];
+      if (element.compareTo(parentElement) >= 0) {
+        break;
+      }
+      heap[index] = parentElement;
+      index = parent;
+    }
+    heap[index] = element;
+    return true;
+  }
+
+  public boolean isEmpty() {
+    return size == 0;
+  }
+
+  public int size() {
+    return size;
+  }
+
+  /** Removes and returns the smallest element, or null if the queue is empty. */
+  public MazeListElement pollFirst() {
+    if (size == 0) {
+      return null;
+    }
+    MazeListElement result = heap[0];
+    MazeListElement last = heap[--size];
+    heap[size] = null;
+    if (size > 0) {
+      int index = 0;
+      int half = size >>> 1;
+      while (index < half) {
+        int child = 2 * index + 1;
+        MazeListElement childElement = heap[child];
+        int right = child + 1;
+        if (right < size && heap[right].compareTo(childElement) < 0) {
+          child = right;
+          childElement = heap[right];
+        }
+        if (last.compareTo(childElement) <= 0) {
+          break;
+        }
+        heap[index] = childElement;
+        index = child;
+      }
+      heap[index] = last;
+    }
+    heldKeys.remove(Key.of(result));
+    return result;
+  }
+}
