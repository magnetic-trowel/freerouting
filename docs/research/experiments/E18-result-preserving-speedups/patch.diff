@@ -0,0 +1,105 @@
+package app.freerouting.autoroute.maze;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertSame;
+
+import app.freerouting.autoroute.expansion.CompleteExpansionRoom;
+import app.freerouting.autoroute.expansion.ExpandableObject;
+import java.util.Random;
+import java.util.TreeSet;
+import org.junit.jupiter.api.Test;
+
+class MazeExpansionQueueTest {
+
+  @Test
+  void behavesLikeATreeSetOrderedByCompareTo() {
+    Random random = new Random(97L);
+    TestDoor[] doors = new TestDoor[12];
+    for (int i = 0; i < doors.length; i++) {
+      // Two door objects share each id, as colliding door ids do in the router.
+      doors[i] = new TestDoor(i / 2);
+    }
+    for (int round = 0; round < 200; round++) {
+      TreeSet<MazeListElement> reference = new TreeSet<>();
+      MazeExpansionQueue queue = new MazeExpansionQueue();
+      for (int step = 0; step < 2_000; step++) {
+        if (random.nextInt(3) > 0 || reference.isEmpty()) {
+          MazeListElement element = randomElement(random, doors);
+          assertEquals(reference.add(element), queue.add(element));
+        } else {
+          assertSame(reference.pollFirst(), queue.pollFirst());
+        }
+        assertEquals(reference.size(), queue.size());
+      }
+      while (!reference.isEmpty()) {
+        assertSame(reference.pollFirst(), queue.pollFirst());
+      }
+      assertNull(queue.pollFirst());
+    }
+  }
+
+  private static MazeListElement randomElement(Random random, TestDoor[] doors) {
+    // Few distinct values, so equal sorting values, equal expansion values and equal keys occur.
+    double sorting = random.nextInt(20) * 0.5;
+    if (sorting == 0.0 && random.nextBoolean()) {
+      sorting = -0.0;
+    }
+    double expansion = random.nextInt(4);
+    return new MazeListElement(
+        doors[random.nextInt(doors.length)],
+        random.nextInt(3),
+        null,
+        0,
+        expansion,
+        sorting,
+        null,
+        null,
+        random.nextBoolean(),
+        null,
+        false);
+  }
+
+  private static final class TestDoor implements ExpandableObject {
+    private final int id;
+
+    private TestDoor(int id) {
+      this.id = id;
+    }
+
+    @Override
+    public app.freerouting.geometry.planar.TileShape getShape() {
+      throw new UnsupportedOperationException();
+    }
+
+    @Override
+    public int getDimension() {
+      return 1;
+    }
+
+    @Override
+    public CompleteExpansionRoom otherRoom(CompleteExpansionRoom room) {
+      return null;
+    }
+
+    @Override
+    public int mazeSearchElementCount() {
+      return 1;
+    }
+
+    @Override
+    public MazeSearchElement getMazeSearchElement(int no) {
+      throw new UnsupportedOperationException();
+    }
+
+    @Override
+    public void reset() {
+      // no-op for tests
+    }
+
+    @Override
+    public int getId() {
+      return id;
+    }
+  }
+}
