+
+  @Test
+  void isOutsideMatchesTheBorderLineSides() {
+    Random random = new Random(20261024L);
+    for (int i = 0; i < 2_000; i++) {
+      IntOctagon octagon = randomOctagon(random);
+      for (int j = 0; j < 50; j++) {
+        IntPoint point = randomPoint(random, octagon);
+        assertEquals(
+            borderLineIsOutside(octagon, point),
+            octagon.isOutside(point),
+            () -> octagon + " " + point);
+      }
+    }
+  }
+
+  @Test
+  void containsOctagonMatchesTheCornerTest() {
+    Random random = new Random(424242L);
+    for (int i = 0; i < 20_000; i++) {
+      IntOctagon octagon = randomOctagon(random);
+      IntOctagon other = random.nextBoolean() ? randomOctagon(random) : shrunk(random, octagon);
+      boolean expected = true;
+      for (int corner = 0; corner < other.borderLineCount(); corner++) {
+        if (borderLineIsOutside(octagon, other.corner(corner))) {
+          expected = false;
+          break;
+        }
+      }
+      assertEquals(expected, octagon.contains((TileShape) other), () -> octagon + " " + other);
+    }
+  }
+
+  /** The generic {@link TileShape#isOutside(Point)} rule, evaluated with line objects. */
+  private static boolean borderLineIsOutside(IntOctagon octagon, Point point) {
+    for (int i = 0; i < octagon.borderLineCount(); i++) {
+      if (octagon.borderLine(i).sideOf(point) == Side.ON_THE_LEFT) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  /** Random octagons, tight or not, including empty and degenerate ones. */
+  private static IntOctagon randomOctagon(Random random) {
+    int cx = random.nextInt(2_000_001) - 1_000_000;
+    int cy = random.nextInt(2_000_001) - 1_000_000;
+    int[] r = new int[8];
+    for (int k = 0; k < 8; k++) {
+      int spread = random.nextInt(3) * 500 + 2;
+      r[k] = random.nextInt(8) == 0 ? -random.nextInt(20) : random.nextInt(spread);
+    }
+    return new IntOctagon(
+        cx - r[0],
+        cy - r[1],
+        cx + r[2],
+        cy + r[3],
+        cx - cy - r[4],
+        cx - cy + r[5],
+        cx + cy - r[6],
+        cx + cy + r[7]);
+  }
+
+  private static IntOctagon shrunk(Random random, IntOctagon o) {
+    return new IntOctagon(
+        o.leftX + random.nextInt(5) - 1,
+        o.bottomY + random.nextInt(5) - 1,
+        o.rightX - random.nextInt(5) + 1,
+        o.topY - random.nextInt(5) + 1,
+        o.upperLeftDiagonalX + random.nextInt(5) - 1,
+        o.lowerRightDiagonalX - random.nextInt(5) + 1,
+        o.lowerLeftDiagonalX + random.nextInt(5) - 1,
+        o.upperRightDiagonalX - random.nextInt(5) + 1);
+  }
+
+  private static IntPoint randomPoint(Random random, IntOctagon octagon) {
+    if (random.nextInt(4) == 0) {
+      IntPoint corner = octagon.corner(random.nextInt(8));
+      return new IntPoint(corner.x + random.nextInt(3) - 1, corner.y + random.nextInt(3) - 1);
+    }
+    int x = octagon.leftX + random.nextInt(Math.max(1, octagon.rightX - octagon.leftX + 3)) - 1;
+    int y = octagon.bottomY + random.nextInt(Math.max(1, octagon.topY - octagon.bottomY + 3)) - 1;
+    return new IntPoint(x, y);
+  }
 }
