+  /**
+   * Returns null if some start item still on the board is now connected to some destination item
+   * still on the board, or if no such pair is left to check. Otherwise removes the traces and vias
+   * of the net that the insertion created (ids above {@code maxItemIdBefore}) and returns FAILED.
+   */
+  private AutorouteAttemptResult verifyInsertedConnection(
+      Set<Item> startSet, Set<Item> destSet, int maxItemIdBefore) {
+    long start = System.nanoTime();
+    try {
+      Boolean connected = connectionState(startSet, destSet, this.netNumber);
+      if (connected == null) {
+        UNVERIFIABLE_CONNECTIONS.incrementAndGet();
+        return null;
+      }
+      if (connected) {
+        VERIFIED_CONNECTIONS.incrementAndGet();
+        return null;
+      }
+      UNCONNECTED_CONNECTIONS.incrementAndGet();
+      List<Item> newItems = new ArrayList<>();
+      for (Item currentItem : board.getConnectableItems(this.netNumber)) {
+        if (currentItem.getId() > maxItemIdBefore
+            && (currentItem instanceof Trace || currentItem instanceof Via)) {
+          newItems.add(currentItem);
+        }
+      }
+      board.removeItems(newItems);
+      FRLogger.trace(
+          "AutorouteEngine.verify_inserted_connection",
+          "unconnected_after_insert",
+          "removed_new_items=" + newItems.size() + ", " + describeConnection(startSet, destSet),
+          "Net #" + this.netNumber,
+          null);
+      return new AutorouteAttemptResult(
+          AutorouteAttemptState.FAILED,
+          "Failed to route connection between "
+              + describeConnection(startSet, destSet)
+              + ", because the inserted path does not connect them.");
+    } finally {
+      VERIFY_NANOS.addAndGet(System.nanoTime() - start);
+    }
+  }
+
+  /**
+   * Returns TRUE if some item of {@code startSet} still on the board is connected to some item of
+   * {@code destSet} still on the board, FALSE if not, and null if one of the sets has no item left
+   * on the board. The start set may hold several components (the unconnected rest of a net), so
+   * each component is visited once.
+   */
+  static Boolean connectionState(Set<Item> startSet, Set<Item> destSet, int netNumber) {
+    boolean anyDest = false;
+    for (Item destItem : destSet) {
+      if (destItem.isOnTheBoard()) {
+        anyDest = true;
+        break;
+      }
+    }
+    if (!anyDest) {
+      return null;
+    }
+    boolean anyStart = false;
+    Set<Item> visited = new TreeSet<>();
+    for (Item startItem : startSet) {
+      if (!startItem.isOnTheBoard() || visited.contains(startItem)) {
+        continue;
+      }
+      anyStart = true;
+      Set<Item> component = startItem.getConnectedSet(netNumber);
+      for (Item member : component) {
+        if (destSet.contains(member)) {
+          return Boolean.TRUE;
+        }
+      }
+      visited.addAll(component);
+    }
+    return anyStart ? Boolean.FALSE : null;
+  }
+
