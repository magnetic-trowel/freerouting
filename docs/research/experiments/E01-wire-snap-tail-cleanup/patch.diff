+  /**
+   * Freerouting connects a trace to a pin only at the exact pin centre. Host tools write wire
+   * coordinates and pad positions with different rounding, so a track that ends on a pad centre in
+   * the host can miss it by a fraction of a micron in the DSN file and would be imported as an open
+   * that the router cannot repair when the wire is fixed. Moves the first and the last corner of a
+   * wire onto the centre of a pin of the wire's net on the wire's layer when the corner lies inside
+   * that pin and at most {@code tolerance} board units away from its centre.
+   */
+  static void snapEndsToPinCenters(
+      BasicBoard board, IntPoint[] corners, int layer, int[] netNumbers, double tolerance) {
+    if (corners.length < 2 || netNumbers.length == 0) {
+      return;
+    }
+    corners[0] = snapToPinCenter(board, corners[0], layer, netNumbers, tolerance);
+    int last = corners.length - 1;
+    corners[last] = snapToPinCenter(board, corners[last], layer, netNumbers, tolerance);
+  }
+
+  private static IntPoint snapToPinCenter(
+      BasicBoard board, IntPoint corner, int layer, int[] netNumbers, double tolerance) {
+    IntPoint result = corner;
+    double bestDistance = Double.MAX_VALUE;
+    for (Item item : board.pickItems(corner, layer, null)) {
+      if (!(item instanceof Pin pin) || !(pin.getCenter() instanceof IntPoint center)) {
+        continue;
+      }
+      boolean sameNet = false;
+      for (int netNumber : netNumbers) {
+        sameNet |= pin.containsNet(netNumber);
+      }
+      if (!sameNet) {
+        continue;
+      }
+      if (center.equals(corner)) {
+        return corner;
+      }
+      double distance = center.toFloat().distance(corner.toFloat());
+      if (distance <= tolerance && distance < bestDistance) {
+        bestDistance = distance;
+        result = center;
+      }
+    }
+    return result;
+  }
