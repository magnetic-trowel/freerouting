@@ -0,0 +1,46 @@
+package app.freerouting.settings;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.Test;
+
+/** The experiment switches select an arm only for an explicit true or false. */
+class ExperimentFlagsTest {
+
+  private static final String NAME = "experiment_flags_test_switch";
+
+  @AfterEach
+  void clearProperty() {
+    System.clearProperty(ExperimentFlags.PROPERTY_PREFIX + NAME);
+  }
+
+  @Test
+  void missingPropertyKeepsTheDefault() {
+    assertTrue(ExperimentFlags.isEnabled(NAME, true));
+    assertFalse(ExperimentFlags.isEnabled(NAME, false));
+  }
+
+  @Test
+  void falseSwitchesTheExperimentOff() {
+    System.setProperty(ExperimentFlags.PROPERTY_PREFIX + NAME, " FALSE ");
+    assertFalse(ExperimentFlags.isEnabled(NAME, true));
+  }
+
+  @Test
+  void trueSwitchesTheExperimentOn() {
+    System.setProperty(ExperimentFlags.PROPERTY_PREFIX + NAME, "true");
+    assertTrue(ExperimentFlags.isEnabled(NAME, false));
+  }
+
+  @Test
+  void otherValuesKeepTheDefault() {
+    System.setProperty(ExperimentFlags.PROPERTY_PREFIX + NAME, "off");
+    assertTrue(ExperimentFlags.isEnabled(NAME, true));
+    assertNull(ExperimentFlags.parse("0"));
+    assertEquals(Boolean.FALSE, ExperimentFlags.parse("False"));
+  }
+}
