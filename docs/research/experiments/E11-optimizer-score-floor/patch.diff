@@ -0,0 +1,48 @@
+package app.freerouting.core.scoring;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import org.junit.jupiter.api.Test;
+
+/** Tests the soft floor of experiment E11 ({@code freerouting.exp.optimizer_score_floor=soft}). */
+class OptimizerScoreSoftFloorTest {
+
+  @Test
+  void keepsTheLinearScoreAboveTheKnee() {
+    assertEquals(1000.0, BoardStatistics.softFloorScore(0.0, 50.0), 0.0);
+    assertEquals(400.0, BoardStatistics.softFloorScore(600.0, 50.0), 0.0);
+    assertEquals(50.0, BoardStatistics.softFloorScore(950.0, 50.0), 0.0);
+  }
+
+  @Test
+  void tailIsContinuousWithTheSameSlopeAtTheKnee() {
+    double knee = 50.0;
+    double epsilon = 1e-6;
+    double atKnee = BoardStatistics.softFloorScore(1000.0 - knee, knee);
+    double justBelow = BoardStatistics.softFloorScore(1000.0 - knee + epsilon, knee);
+    assertEquals(atKnee, justBelow, 1e-5);
+    assertEquals(-1.0, (justBelow - atKnee) / epsilon, 1e-3);
+  }
+
+  @Test
+  void tailStaysPositiveAndStrictlyDecreasing() {
+    double previous = Double.POSITIVE_INFINITY;
+    for (double penalty = 900.0; penalty <= 1.0e6; penalty *= 1.5) {
+      double score = BoardStatistics.softFloorScore(penalty, 50.0);
+      assertTrue(score > 0.0, "score at penalty " + penalty);
+      assertTrue(score < previous, "score must decrease at penalty " + penalty);
+      previous = score;
+    }
+  }
+
+  @Test
+  void tailRanksPenaltiesBeyondTheClampedFloor() {
+    // Both penalties score 0 with the clamp; the soft floor still prefers the smaller one.
+    double better = BoardStatistics.softFloorScore(2900.0, 50.0);
+    double worse = BoardStatistics.softFloorScore(3000.0, 50.0);
+    assertTrue(better > worse);
+    assertEquals(2500.0 / 2000.0, better, 1e-12);
+    assertEquals(2500.0 / 2100.0, worse, 1e-12);
+  }
+}
