+
+  /** Experiment E11: the score below which the soft floor's tail starts. */
+  private static final double EXP_SCORE_FLOOR_KNEE =
+      Math.min(
+          1000.0,
+          Math.max(
+              1.0,
+              Double.parseDouble(
+                  System.getProperty("freerouting.exp.optimizer_score_floor_knee", "50").trim())));
+
+  /**
+   * Returns {@code 1000 - penalty} down to {@code knee} and then a tail {@code knee^2 / (knee + t)},
+   * where {@code t} is the penalty beyond the knee. The tail has the value and the slope of the
+   * line at the knee, decreases strictly and stays positive, so a smaller penalty always scores
+   * higher; in the tail the relative score change equals the relative change of {@code knee + t}.
+   */
+  static double softFloorScore(double penalty, double knee) {
+    double kneePenalty = 1000.0 - knee;
+    if (penalty <= kneePenalty) {
+      return 1000.0 - penalty;
+    }
+    return knee * knee / (knee + (penalty - kneePenalty));
+  }
