diff --git a/src/test/java/app/freerouting/autoroute/StoredBoardTest.java b/src/test/java/app/freerouting/autoroute/StoredBoardTest.java
new file mode 100644
index 00000000..a451cd5b
--- /dev/null
+++ b/src/test/java/app/freerouting/autoroute/StoredBoardTest.java
@@ -0,0 +1,75 @@
+package app.freerouting.autoroute;
+
+import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertSame;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import app.freerouting.board.actions.ItemIdGenerator;
+import app.freerouting.board.facade.BasicBoard;
+import app.freerouting.board.facade.RoutingBoard;
+import app.freerouting.board.state.BoardObserverAdaptor;
+import app.freerouting.core.RoutingJob;
+import app.freerouting.management.HeadlessBoardManager;
+import java.io.FileInputStream;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.Test;
+
+class StoredBoardTest {
+
+  private static RoutingBoard board;
+
+  @BeforeAll
+  static void loadBoard() throws Exception {
+    HeadlessBoardManager manager = new HeadlessBoardManager(new RoutingJob());
+    try (FileInputStream input = new FileInputStream("fixtures/Issue159-setonix_2hp-pcb.dsn")) {
+      manager.loadFromSpecctraDsn(input, new BoardObserverAdaptor(), new ItemIdGenerator());
+    }
+    board = manager.getRoutingBoard();
+  }
+
+  @Test
+  void compressedBytesInflateToTheSerializedBytes() {
+    byte[] serialized = board.serialize(false);
+    StoredBoard stored = StoredBoard.of(serialized, true);
+
+    assertTrue(stored.isCompressed());
+    assertTrue(
+        stored.storedLength() < serialized.length / 2,
+        "a serialized board should compress at least 2x, got "
+            + serialized.length
+            + " -> "
+            + stored.storedLength());
+    assertArrayEquals(serialized, stored.serialized());
+  }
+
+  @Test
+  void uncompressedBytesAreKeptAsGiven() {
+    byte[] serialized = board.serialize(false);
+    StoredBoard stored = StoredBoard.of(serialized, false);
+
+    assertFalse(stored.isCompressed());
+    assertEquals(serialized.length, stored.storedLength());
+    assertSame(serialized, stored.serialized());
+  }
+
+  @Test
+  void compressedAndUncompressedRestoreTheSameBoard() {
+    byte[] serialized = board.serialize(false);
+    BasicBoard fromCompressed = StoredBoard.of(serialized, true).restore();
+    BasicBoard fromPlain = StoredBoard.of(serialized, false).restore();
+
+    assertNotNull(fromCompressed);
+    assertEquals(board.getHash(), fromCompressed.getHash());
+    assertArrayEquals(fromPlain.serialize(false), fromCompressed.serialize(false));
+  }
+
+  @Test
+  void nullBytesStoreNothing() {
+    assertNull(StoredBoard.of(null, true));
+    assertNull(StoredBoard.of(null, false));
+  }
+}
