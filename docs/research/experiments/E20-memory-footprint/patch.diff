diff --git a/src/main/java/app/freerouting/autoroute/StoredBoard.java b/src/main/java/app/freerouting/autoroute/StoredBoard.java
new file mode 100644
index 00000000..48a0d13d
--- /dev/null
+++ b/src/main/java/app/freerouting/autoroute/StoredBoard.java
@@ -0,0 +1,113 @@
+package app.freerouting.autoroute;
+
+import app.freerouting.board.facade.BasicBoard;
+import java.io.ByteArrayOutputStream;
+import java.util.zip.DataFormatException;
+import java.util.zip.Deflater;
+import java.util.zip.Inflater;
+
+/**
+ * A board kept in memory as the bytes {@link BasicBoard#serialize(boolean)} produced, optionally
+ * Deflate-compressed. Restoring inflates exactly those bytes before deserializing them, so a
+ * compressed and an uncompressed copy restore identical boards.
+ *
+ * <p>Experiment E20: {@code -Dfreerouting.exp.compress_boards=true} compresses the board history
+ * entries and the routing-fallback input. The default keeps the bytes uncompressed.
+ */
+public final class StoredBoard {
+
+  /** Whether stored boards are compressed; read once at startup. */
+  public static final boolean COMPRESS = Boolean.getBoolean("freerouting.exp.compress_boards");
+
+  private final byte[] data;
+
+  /** The length of the uncompressed bytes, or -1 when {@link #data} is not compressed. */
+  private final int rawLength;
+
+  private StoredBoard(byte[] data, int rawLength) {
+    this.data = data;
+    this.rawLength = rawLength;
+  }
+
+  /**
+   * Stores the complete board, compressed when the experiment switch is on. Returns null when the
+   * board could not be serialized.
+   */
+  public static StoredBoard of(BasicBoard board) {
+    return of(board.serialize(false), COMPRESS);
+  }
+
+  /** Stores already serialized board bytes; returns null for null bytes. */
+  public static StoredBoard of(byte[] serialized, boolean compress) {
+    if (serialized == null) {
+      return null;
+    }
+    if (!compress) {
+      return new StoredBoard(serialized, -1);
+    }
+    return new StoredBoard(deflate(serialized), serialized.length);
+  }
+
+  /** Returns a new board deserialized from the stored bytes. */
+  public BasicBoard restore() {
+    return BasicBoard.deserialize(serialized());
+  }
+
+  /** Returns the uncompressed serialized bytes. */
+  public byte[] serialized() {
+    return rawLength < 0 ? data : inflate(data, rawLength);
+  }
+
+  /** Returns whether the bytes are kept compressed. */
+  public boolean isCompressed() {
+    return rawLength >= 0;
+  }
+
+  /** Returns the number of bytes held in memory. */
+  public int storedLength() {
+    return data.length;
+  }
+
+  private static byte[] deflate(byte[] raw) {
+    Deflater deflater = new Deflater(Deflater.BEST_SPEED);
+    try {
+      deflater.setInput(raw);
+      deflater.finish();
+      ByteArrayOutputStream out = new ByteArrayOutputStream(Math.max(64, raw.length / 4));
+      byte[] buffer = new byte[64 * 1024];
+      while (!deflater.finished()) {
+        int n = deflater.deflate(buffer);
+        out.write(buffer, 0, n);
+      }
+      return out.toByteArray();
+    } finally {
+      deflater.end();
+    }
+  }
+
+  private static byte[] inflate(byte[] compressed, int rawLength) {
+    Inflater inflater = new Inflater();
+    try {
+      inflater.setInput(compressed);
+      byte[] raw = new byte[rawLength];
+      int offset = 0;
+      while (offset < rawLength) {
+        int n = inflater.inflate(raw, offset, rawLength - offset);
+        if (n == 0
+            && (inflater.finished() || inflater.needsInput() || inflater.needsDictionary())) {
+          break;
+        }
+        offset += n;
+      }
+      if (offset != rawLength) {
+        throw new IllegalStateException(
+            "Stored board inflated to " + offset + " of " + rawLength + " bytes");
+      }
+      return raw;
+    } catch (DataFormatException e) {
+      throw new IllegalStateException("Stored board is corrupt", e);
+    } finally {
+      inflater.end();
+    }
+  }
+}
