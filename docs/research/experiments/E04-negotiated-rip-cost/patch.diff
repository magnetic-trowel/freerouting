--- /dev/null
+++ b/src/main/java/app/freerouting/autoroute/pipeline/NetRipHistory.java
@@ -0,0 +1,97 @@
+package app.freerouting.autoroute.pipeline;
+
+import app.freerouting.autoroute.maze.AutorouteControl;
+import app.freerouting.board.facade.RoutingBoard;
+import app.freerouting.board.model.items.Item;
+import java.util.Collection;
+import java.util.SortedSet;
+import java.util.TreeSet;
+
+/**
+ * Experiment E04 (negotiated rip cost): counts, per net, how often a connection attempt ripped the
+ * net's copper. The counts live in the autorouter, not on the board, so they survive passes and the
+ * board restores of the pass loop. Each rip of a victim net then costs {@code 1 + weight * count}
+ * times its normal rip cost, as in the history term of PathFinder-style negotiated congestion. A
+ * weight of 0 (the default) turns the history off and leaves routing unchanged.
+ */
+final class NetRipHistory {
+
+  /** System property holding the weight; 0, negative, unparsable or absent disables the history. */
+  static final String PROPERTY = "freerouting.exp.rip_history";
+
+  /** The weight from {@link #PROPERTY}, read once at startup. */
+  static final double WEIGHT = parseWeight(System.getProperty(PROPERTY));
+
+  private final double weight;
+  private int[] ripCounts;
+
+  NetRipHistory(double weight) {
+    this.weight = weight;
+  }
+
+  static double parseWeight(String value) {
+    if (value == null) {
+      return 0;
+    }
+    try {
+      double parsed = Double.parseDouble(value.trim());
+      return Double.isFinite(parsed) && parsed > 0 ? parsed : 0;
+    } catch (NumberFormatException e) {
+      return 0;
+    }
+  }
+
+  boolean isEnabled() {
+    return this.weight > 0;
+  }
+
+  /** Lets the maze search of {@code control} price rips with the history; no-op when disabled. */
+  void applyTo(AutorouteControl control, RoutingBoard board) {
+    if (!isEnabled()) {
+      return;
+    }
+    control.netRipHistory = counts(board);
+    control.ripHistoryWeight = this.weight;
+  }
+
+  /**
+   * Counts one rip-up for every net of the given ripped items (each net once per attempt). Called
+   * after every connection attempt whose ripped items were removed from the board.
+   */
+  void record(Collection<Item> rippedItems, RoutingBoard board) {
+    if (!isEnabled() || rippedItems.isEmpty()) {
+      return;
+    }
+    SortedSet<Integer> nets = new TreeSet<>();
+    for (Item ripped : rippedItems) {
+      for (int i = 0; i < ripped.netCount(); i++) {
+        nets.add(ripped.getNetNumber(i));
+      }
+    }
+    int[] counts = counts(board);
+    for (int net : nets) {
+      if (net >= 0 && net < counts.length) {
+        counts[net]++;
+      }
+    }
+  }
+
+  /** The rip-up count of the given net so far. */
+  int count(int netNumber) {
+    return this.ripCounts != null && netNumber >= 0 && netNumber < this.ripCounts.length
+        ? this.ripCounts[netNumber]
+        : 0;
+  }
+
+  private int[] counts(RoutingBoard board) {
+    int size = board.rules.nets.maxNetNumber() + 1;
+    if (this.ripCounts == null || this.ripCounts.length < size) {
+      int[] grown = new int[size];
+      if (this.ripCounts != null) {
+        System.arraycopy(this.ripCounts, 0, grown, 0, this.ripCounts.length);
+      }
+      this.ripCounts = grown;
+    }
+    return this.ripCounts;
+  }
+}
