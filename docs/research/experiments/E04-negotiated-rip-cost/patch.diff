+package app.freerouting.autoroute.maze;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertInstanceOf;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+
+import app.freerouting.board.facade.RoutingBoard;
+import app.freerouting.board.model.items.Item;
+import app.freerouting.io.BoardReadResult;
+import app.freerouting.io.specctra.DsnReader;
+import java.io.ByteArrayInputStream;
+import java.nio.charset.StandardCharsets;
+import org.junit.jupiter.api.Test;
+
+/** Experiment E04: the rip cost factor grows linearly with the victim net's rip history. */
+class RipHistoryFactorTest {
+
+  private static final String DSN =
+      """
+      (pcb factor (resolution um 1)
+        (structure (layer top (type signal))
+          (boundary (rect pcb 0 0 20000 10000))
+          (via V) (rule (width 400) (clearance 200)))
+        (placement (component C (place A 3000 3000 front 0) (place B 17000 3000 front 0)))
+        (library (image C (pin S 1 0 0)) (padstack S (shape (circle top 800)))
+          (padstack V (shape (circle top 600)) (attach off)))
+        (network (net X (pins A-1 B-1))))
+      """;
+
+  @Test
+  void factorIsOnePlusWeightTimesTheNetsRipCount() {
+    BoardReadResult result =
+        DsnReader.readBoard(
+            new ByteArrayInputStream(DSN.getBytes(StandardCharsets.UTF_8)), null, null, "factor");
+    assertInstanceOf(BoardReadResult.Success.class, result);
+    RoutingBoard board = (RoutingBoard) ((BoardReadResult.Success) result).board();
+    Item pin = board.getPins().stream().findFirst().map(Item.class::cast).orElse(null);
+    assertNotNull(pin);
+    int net = pin.getNetNumber(0);
+    int[] history = new int[net + 1];
+
+    assertEquals(1.0, MazeRipupResolver.ripHistoryFactor(pin, history, 2.0));
+    history[net] = 3;
+    assertEquals(7.0, MazeRipupResolver.ripHistoryFactor(pin, history, 2.0));
+    assertEquals(2.5, MazeRipupResolver.ripHistoryFactor(pin, history, 0.5));
+    // Nets beyond the history array have no history.
+    assertEquals(1.0, MazeRipupResolver.ripHistoryFactor(pin, new int[0], 2.0));
+  }
+}
diff --git a/src/test/java/app/freerouting/autoroute/pipeline/NetRipHistoryTest.java b/src/test/java/app/freerouting/autoroute/pipeline/NetRipHistoryTest.java
new file mode 100644
index 00000000..4368264b
--- /dev/null
+++ b/src/test/java/app/freerouting/autoroute/pipeline/NetRipHistoryTest.java
@@ -0,0 +1,124 @@
+package app.freerouting.autoroute.pipeline;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertInstanceOf;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertSame;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import app.freerouting.autoroute.maze.AutorouteControl;
+import app.freerouting.board.facade.RoutingBoard;
+import app.freerouting.board.model.items.Item;
+import app.freerouting.board.model.items.Pin;
+import app.freerouting.board.model.structure.FixedState;
+import app.freerouting.geometry.planar.IntPoint;
+import app.freerouting.geometry.planar.Point;
+import app.freerouting.geometry.planar.Polyline;
+import app.freerouting.io.BoardReadResult;
+import app.freerouting.io.specctra.DsnReader;
+import app.freerouting.settings.RouterSettings;
+import app.freerouting.settings.SettingsMerger;
+import app.freerouting.settings.sources.DefaultSettings;
+import java.io.ByteArrayInputStream;
+import java.nio.charset.StandardCharsets;
+import java.util.List;
+import org.junit.jupiter.api.Test;
+
+/** Experiment E04: the per-net rip history counts rips and stays off by default. */
+class NetRipHistoryTest {
+
+  private static final String DSN =
+      """
+      (pcb riphistory (resolution um 1)
+        (structure (layer top (type signal))
+          (boundary (rect pcb 0 0 20000 10000))
+          (via V) (rule (width 400) (clearance 200)))
+        (placement (component C (place A 3000 3000 front 0) (place B 17000 3000 front 0)))
+        (library (image C (pin S 1 0 0)) (padstack S (shape (circle top 800)))
+          (padstack V (shape (circle top 600)) (attach off)))
+        (network (net X (pins A-1 B-1))))
+      """;
+
+  @Test
+  void parseWeightAcceptsOnlyPositiveFiniteNumbers() {
+    assertEquals(0, NetRipHistory.parseWeight(null));
+    assertEquals(0, NetRipHistory.parseWeight(""));
+    assertEquals(0, NetRipHistory.parseWeight("abc"));
+    assertEquals(0, NetRipHistory.parseWeight("-1"));
+    assertEquals(0, NetRipHistory.parseWeight("NaN"));
+    assertEquals(0, NetRipHistory.parseWeight("Infinity"));
+    assertEquals(0, NetRipHistory.parseWeight("0"));
+    assertEquals(0.5, NetRipHistory.parseWeight(" 0.5 "));
+    assertEquals(2, NetRipHistory.parseWeight("2"));
+  }
+
+  @Test
+  void disabledHistoryLeavesTheControlUntouched() {
+    RoutingBoard board = board();
+    NetRipHistory history = new NetRipHistory(0);
+    assertFalse(history.isEnabled());
+    AutorouteControl control = control(board);
+    history.applyTo(control, board);
+    assertNull(control.netRipHistory);
+    history.record(List.of(trace(board)), board);
+    assertEquals(0, history.count(net(board)));
+  }
+
+  @Test
+  void enabledHistoryCountsEachRippedNetOncePerAttempt() {
+    RoutingBoard board = board();
+    NetRipHistory history = new NetRipHistory(1.5);
+    assertTrue(history.isEnabled());
+    Item trace = trace(board);
+    int net = net(board);
+
+    history.record(List.of(trace, trace), board);
+    assertEquals(1, history.count(net));
+    history.record(List.of(), board);
+    history.record(List.of(trace), board);
+    assertEquals(2, history.count(net));
+
+    AutorouteControl control = control(board);
+    history.applyTo(control, board);
+    assertNotNull(control.netRipHistory);
+    assertEquals(2, control.netRipHistory[net]);
+    assertEquals(1.5, control.ripHistoryWeight);
+    AutorouteControl other = control(board);
+    history.applyTo(other, board);
+    assertSame(control.netRipHistory, other.netRipHistory);
+  }
+
+  static RoutingBoard board() {
+    BoardReadResult result =
+        DsnReader.readBoard(
+            new ByteArrayInputStream(DSN.getBytes(StandardCharsets.UTF_8)), null, null, "rip");
+    assertInstanceOf(BoardReadResult.Success.class, result);
+    return (RoutingBoard) ((BoardReadResult.Success) result).board();
+  }
+
+  static int net(RoutingBoard board) {
+    return board.rules.nets.get("X").iterator().next().netNumber;
+  }
+
+  static Item trace(RoutingBoard board) {
+    Point[] pins = board.getPins().stream().map(Pin::getCenter).toArray(Point[]::new);
+    Item trace =
+        board.insertTraceWithoutCleaning(
+            new Polyline(new Point[] {pins[0], new IntPoint(10000, 3000), pins[1]}),
+            0,
+            200,
+            new int[] {net(board)},
+            1,
+            FixedState.UNFIXED);
+    assertNotNull(trace);
+    return trace;
+  }
+
+  private static AutorouteControl control(RoutingBoard board) {
+    RouterSettings settings = new SettingsMerger(new DefaultSettings()).merge();
+    settings.setLayerCount(board.getLayerCount());
+    return new AutorouteControl(board, net(board), settings);
+  }
+}
