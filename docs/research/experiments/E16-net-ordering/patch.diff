+package app.freerouting.autoroute.pipeline;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertInstanceOf;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import app.freerouting.autoroute.AutorouteAttemptState;
+import app.freerouting.board.facade.RoutingBoard;
+import app.freerouting.board.model.items.Item;
+import app.freerouting.board.model.items.Pin;
+import app.freerouting.geometry.planar.FloatPoint;
+import app.freerouting.io.BoardReadResult;
+import app.freerouting.io.specctra.DsnReader;
+import java.io.FileInputStream;
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Random;
+import java.util.Set;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.EnumSource;
+
+class RouteOrderTest {
+
+  @Test
+  void unsetBlankAndDefaultKeepTheRouterOrder() {
+    assertNull(RouteOrder.parseMode(null));
+    assertNull(RouteOrder.parseMode(""));
+    assertNull(RouteOrder.parseMode("  default "));
+    assertNull(RouteOrder.parseMode("no_such_order"));
+  }
+
+  @Test
+  void everyModeParsesFromItsKey() {
+    for (RouteOrder.Mode mode : RouteOrder.Mode.values()) {
+      assertEquals(mode, RouteOrder.parseMode(mode.key));
+      assertEquals(mode, RouteOrder.parseMode(" " + mode.key.toUpperCase() + " "));
+    }
+  }
+
+  @Test
+  void sortsByKeyThenNetThenId() {
+    List<RouteOrder.Keyed> entries =
+        List.of(
+            new RouteOrder.Keyed(null, 2.0, 1, 10),
+            new RouteOrder.Keyed(null, 1.0, 5, 30),
+            new RouteOrder.Keyed(null, 1.0, 5, 20),
+            new RouteOrder.Keyed(null, 1.0, 3, 40),
+            new RouteOrder.Keyed(null, -1.0, 9, 50));
+    List<Integer> ids = new ArrayList<>();
+    for (RouteOrder.Keyed entry : RouteOrder.sorted(entries)) {
+      ids.add(entry.id());
+    }
+    assertEquals(List.of(50, 40, 20, 30, 10), ids);
+  }
+
+  @Test
+  void historyRecordsFailuresAndHalvesDifficultyEachPass() {
+    RouteOrder order = new RouteOrder(RouteOrder.Mode.LEARNED, 650.0, 1500.0);
+    order.recordAttempt(7, AutorouteAttemptState.FAILED, List.of());
+    order.recordAttempt(7, AutorouteAttemptState.ROUTED, List.of());
+    order.recordAttempt(8, AutorouteAttemptState.ALREADY_CONNECTED, List.of());
+    assertEquals(0, order.failuresLastPass(7));
+    order.endPass();
+    assertEquals(1, order.failuresLastPass(7));
+    assertEquals(0, order.failuresLastPass(8));
+    assertEquals(RouteOrder.FAILURE_WEIGHT, order.difficulty(7));
+    order.endPass();
+    assertEquals(0, order.failuresLastPass(7));
+    assertEquals(RouteOrder.FAILURE_WEIGHT / 2, order.difficulty(7));
+  }
+
+  @Test
+  void failureStatesMatchThePassRunner() {
+    assertTrue(RouteOrder.isFailure(AutorouteAttemptState.FAILED));
+    assertTrue(RouteOrder.isFailure(AutorouteAttemptState.INSERT_ERROR));
+    assertEquals(false, RouteOrder.isFailure(AutorouteAttemptState.ROUTED));
+    assertEquals(false, RouteOrder.isFailure(AutorouteAttemptState.ALREADY_CONNECTED));
+    assertEquals(false, RouteOrder.isFailure(AutorouteAttemptState.NO_UNCONNECTED_NETS));
+    assertEquals(false, RouteOrder.isFailure(AutorouteAttemptState.CONNECTED_TO_PLANE));
+  }
+
+  @Test
+  void gridNeighbourCountsMatchBruteForce() {
+    Random random = new Random(42);
+    List<FloatPoint> points = new ArrayList<>();
+    for (int i = 0; i < 400; i++) {
+      points.add(new FloatPoint(random.nextInt(20000) - 10000, random.nextInt(20000) - 10000));
+    }
+    double radius = 1500.0;
+    int[] counts = RouteOrder.neighbourCounts(points, radius);
+    for (int i = 0; i < points.size(); i++) {
+      int expected = 0;
+      for (int j = 0; j < points.size(); j++) {
+        if (i != j && points.get(i).distance(points.get(j)) <= radius) {
+          expected++;
+        }
+      }
+      assertEquals(expected, counts[i], "point " + i);
+    }
+  }
+
+  @Test
+  void minPitchIgnoresCoincidentPoints() {
+    List<FloatPoint> points =
+        List.of(
+            new FloatPoint(0, 0),
+            new FloatPoint(0, 0),
+            new FloatPoint(500, 0),
+            new FloatPoint(500, 2000));
+    assertEquals(500.0, RouteOrder.minPitch(points), 1e-9);
+    assertEquals(Double.MAX_VALUE, RouteOrder.minPitch(List.of(new FloatPoint(1, 1))));
+  }
+
+  @ParameterizedTest
+  @EnumSource(RouteOrder.Mode.class)
+  void orderIsPermutationIndependentOfInputOrder(RouteOrder.Mode mode) throws IOException {
+    RoutingBoard board = loadCaniot();
+    List<Item> pins = new ArrayList<>(board.getPins());
+    RouteOrder order = new RouteOrder(mode, 650.0, 1500.0);
+
+    List<Item> forward = new ArrayList<>(pins);
+    order.apply(forward, board, item -> false);
+    List<Item> shuffled = new ArrayList<>(pins);
+    Collections.shuffle(shuffled, new Random(7));
+    order.apply(shuffled, board, item -> false);
+
+    assertEquals(pins.size(), forward.size());
+    assertEquals(new HashSet<>(pins), new HashSet<>(forward));
+    assertEquals(ids(forward), ids(shuffled));
+  }
+
+  @Test
+  void planeItemsStayInFrontInTheirOrder() throws IOException {
+    RoutingBoard board = loadCaniot();
+    List<Item> pins = new ArrayList<>(board.getPins());
+    Item firstPlane = pins.get(pins.size() - 1);
+    Item secondPlane = pins.get(0);
+    Set<Item> planes = Set.of(firstPlane, secondPlane);
+    List<Item> items = new ArrayList<>(pins);
+    Collections.swap(items, 0, items.size() - 1);
+    new RouteOrder(RouteOrder.Mode.LONG_FIRST, 650.0, 1500.0).apply(items, board, planes::contains);
+    assertEquals(firstPlane, items.get(0));
+    assertEquals(secondPlane, items.get(1));
+  }
+
