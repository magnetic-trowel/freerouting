@@ -0,0 +1,98 @@
+package app.freerouting.autoroute.pipeline;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertInstanceOf;
+import static org.junit.jupiter.api.Assertions.assertNotSame;
+import static org.junit.jupiter.api.Assertions.assertSame;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import app.freerouting.board.facade.RoutingBoard;
+import app.freerouting.core.StoppableThread;
+import app.freerouting.io.BoardReadResult;
+import app.freerouting.io.specctra.DsnReader;
+import app.freerouting.settings.RouterSettings;
+import app.freerouting.settings.SettingsMerger;
+import app.freerouting.settings.sources.DefaultSettings;
+import java.io.ByteArrayInputStream;
+import java.nio.charset.StandardCharsets;
+import org.junit.jupiter.api.Test;
+
+/** Experiment E06: the transaction runs only on stagnation and is adopted only if it helps. */
+class TransactionalLastMileTest {
+
+  private static final String DSN =
+      """
+      (pcb lastmile (resolution um 1)
+        (structure (layer top (type signal))
+          (boundary (rect pcb 0 0 20000 10000))
+          (via V) (rule (width 400) (clearance 200)))
+        (placement (component C (place A 3000 3000 front 0) (place B 17000 3000 front 0)))
+        (library (image C (pin S 1 0 0)) (padstack S (shape (circle top 800)))
+          (padstack V (shape (circle top 600)) (attach off)))
+        (network (net X (pins A-1 B-1))))
+      """;
+
+  @Test
+  void parseMaxAttemptsDefaultsToOff() {
+    assertEquals(0, TransactionalLastMile.MAX_ATTEMPTS);
+    assertEquals(0, TransactionalLastMile.parseMaxAttempts(null));
+    assertEquals(0, TransactionalLastMile.parseMaxAttempts("x"));
+    assertEquals(0, TransactionalLastMile.parseMaxAttempts("-3"));
+    assertEquals(4, TransactionalLastMile.parseMaxAttempts(" 4 "));
+  }
+
+  @Test
+  void runsOnlyAfterStagnationAndAdoptsAnImprovingCopy() {
+    BatchAutorouter router = router();
+    final RoutingBoard original = router.board;
+    TransactionalLastMile lastMile = new TransactionalLastMile(router, 3);
+
+    assertFalse(lastMile.afterPass(1));
+    assertFalse(lastMile.afterPass(2));
+    assertEquals(0, lastMile.attempts());
+    assertSame(original, router.board);
+
+    assertTrue(lastMile.afterPass(3));
+    assertEquals(1, lastMile.attempts());
+    assertEquals(1, lastMile.accepted());
+    assertNotSame(original, router.board);
+    assertEquals(0, router.calculateIncompleteCount(router.board));
+    // The original board is untouched by the transaction.
+    assertEquals(1, router.calculateIncompleteCount(original));
+    // Nothing is open any more, so no further transactions run.
+    assertFalse(lastMile.afterPass(4));
+    assertEquals(1, lastMile.attempts());
+  }
+
+  @Test
+  void stopsAtTheAttemptBudget() {
+    BatchAutorouter router = router();
+    TransactionalLastMile lastMile = new TransactionalLastMile(router, 0);
+    for (int pass = 1; pass <= 5; pass++) {
+      assertFalse(lastMile.afterPass(pass));
+    }
+    assertEquals(0, lastMile.attempts());
+  }
+
+  private static BatchAutorouter router() {
+    BoardReadResult result =
+        DsnReader.readBoard(
+            new ByteArrayInputStream(DSN.getBytes(StandardCharsets.UTF_8)), null, null, "lm");
+    assertInstanceOf(BoardReadResult.Success.class, result);
+    RoutingBoard board = (RoutingBoard) ((BoardReadResult.Success) result).board();
+    RouterSettings settings = new SettingsMerger(new DefaultSettings()).merge();
+    settings.setLayerCount(board.getLayerCount());
+    return new BatchAutorouter(
+        new StoppableThread() {
+          @Override
+          protected void threadAction() {}
+        },
+        board,
+        settings,
+        true,
+        true,
+        settings.getStartRipupCosts(),
+        500);
+  }
+}
