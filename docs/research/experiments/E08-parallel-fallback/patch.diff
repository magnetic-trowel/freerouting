+package app.freerouting.autoroute.pipeline;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import app.freerouting.core.RoutingJob;
+import app.freerouting.core.RoutingJobState;
+import app.freerouting.core.StoppableThread;
+import app.freerouting.settings.AutorouterSettings;
+import app.freerouting.settings.RouterSettings;
+import java.util.ArrayList;
+import java.util.List;
+import org.junit.jupiter.api.Test;
+
+class ParallelFallbackAttemptsTest {
+
+  @Test
+  void propertyParsesToZeroUnlessPositiveInteger() {
+    assertEquals(0, ParallelFallbackAttempts.parseThreads(null));
+    assertEquals(0, ParallelFallbackAttempts.parseThreads(" "));
+    assertEquals(0, ParallelFallbackAttempts.parseThreads("four"));
+    assertEquals(0, ParallelFallbackAttempts.parseThreads("-2"));
+    assertEquals(4, ParallelFallbackAttempts.parseThreads(" 4 "));
+  }
+
+  @Test
+  void threadsAreCappedByMaxThreadsAndStrategyCount() {
+    RouterSettings settings = new RouterSettings();
+    settings.autorouter = new AutorouterSettings();
+    settings.autorouter.maxThreads = 1;
+    assertEquals(0, ParallelFallbackAttempts.effectiveThreads(4, settings, 5));
+
+    settings.autorouter.maxThreads = 64;
+    int cores = settings.getAutorouterMaxThreads();
+    int expected = Math.min(3, cores) >= 2 ? Math.min(3, cores) : 0;
+    assertEquals(expected, ParallelFallbackAttempts.effectiveThreads(8, settings, 3));
+    assertEquals(0, ParallelFallbackAttempts.effectiveThreads(1, settings, 5));
+    assertEquals(0, ParallelFallbackAttempts.effectiveThreads(4, settings, 1));
+    assertEquals(0, ParallelFallbackAttempts.effectiveThreads(0, settings, 5));
+  }
+
+  @Test
+  void attemptLogLinesReplayInOrderUpToTheMark() {
+    RecordingJob parent = new RecordingJob();
+    ParallelFallbackAttempts.AttemptJob attempt =
+        new ParallelFallbackAttempts.AttemptJob(parent, new RouterSettings());
+    attempt.logInfo("one");
+    attempt.logWarning("two");
+    attempt.logDebug("three");
+    assertTrue(parent.lines.isEmpty(), "worker lines are buffered");
+
+    attempt.replay(parent, 2);
+    assertEquals(List.of("I:one", "W:two"), parent.lines);
+  }
+
+  @Test
+  void attemptStopIsPrivateButFollowsTheJob() {
+    RecordingJob parent = new RecordingJob();
+    parent.thread = new IdleThread();
+    parent.state = RoutingJobState.RUNNING;
+    ParallelFallbackAttempts.AttemptJob attempt =
+        new ParallelFallbackAttempts.AttemptJob(parent, new RouterSettings());
+
+    attempt.thread.requestStopAutoRouter();
+    assertTrue(attempt.thread.isStopAutoRouterRequested());
+    assertFalse(parent.thread.isStopAutoRouterRequested(), "the job thread is not stopped");
+
+    attempt.thread.resetAutoRouterStopRequest();
+    assertFalse(attempt.thread.isStopAutoRouterRequested());
+    parent.state = RoutingJobState.TIMED_OUT;
+    attempt.thread.isStopAutoRouterRequested();
+    assertEquals(RoutingJobState.TIMED_OUT, attempt.state, "the timeout reaches the attempt");
+
+    parent.thread.requestStop();
+    assertTrue(attempt.thread.isStopRequested());
+    assertTrue(attempt.thread.isStopAutoRouterRequested());
+  }
+
+  private static final class RecordingJob extends RoutingJob {
+    final List<String> lines = new ArrayList<>();
+
+    @Override
+    public void logInfo(String message) {
+      this.lines.add("I:" + message);
+    }
+
+    @Override
+    public void logWarning(String message) {
+      this.lines.add("W:" + message);
+    }
+
+    @Override
+    public void logDebug(String message) {
+      this.lines.add("D:" + message);
+    }
+
+    @Override
+    public void logError(String message, Throwable ex) {
+      this.lines.add("E:" + message);
+    }
+  }
+
+  private static final class IdleThread extends StoppableThread {
+    @Override
+    protected void threadAction() {}
+  }
+}
