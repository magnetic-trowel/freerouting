+package app.freerouting.autoroute.pipeline;
+
+import app.freerouting.board.facade.BasicBoard;
+import app.freerouting.board.facade.RoutingBoard;
+import app.freerouting.core.RoutingJob;
+import app.freerouting.core.RoutingJobState;
+import app.freerouting.core.StoppableThread;
+import app.freerouting.drc.ClearanceBaseline;
+import app.freerouting.settings.RouterSettings;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.concurrent.ExecutionException;
+import java.util.concurrent.Future;
+import java.util.concurrent.LinkedBlockingQueue;
+import java.util.concurrent.ThreadPoolExecutor;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicInteger;
+
+/**
+ * Experiment {@code -Dfreerouting.exp.parallel_fallback=<threads>}: runs the fallback's alternative
+ * strategies on worker threads ahead of the sequential fold in {@link RoutingFallbackRunner}. Every
+ * alternative starts from the same input bytes and its own settings copy, so a worker computes the
+ * board the sequential loop would compute. The fold takes the results in strategy order and applies
+ * the unchanged replace and stop checks, so the chosen board is the sequential one; results after
+ * the point where the fold stops are discarded.
+ *
+ * <p>A fanout-only strategy stops after its fanout when the post-fanout board repeats an earlier
+ * pass loop. Workers only know the pass loops that started before they were launched, so the fold
+ * re-checks the hash against the pass loops folded so far and treats a late match as that stop.
+ *
+ * <p>Each worker routes through a private {@link RoutingJob} view: its own board, settings, stop
+ * flag and phase metrics, with log lines buffered and replayed through the real job when the fold
+ * takes the attempt. Worker attempts do not forward board or task events to the job's listeners,
+ * and they leave the global {@code PerformanceProfiler} configuration and totals alone.
+ */
+final class ParallelFallbackAttempts implements AutoCloseable {
+
+  static final String PROPERTY = "freerouting.exp.parallel_fallback";
+
+  /** Worker threads requested at startup; 0 or 1 keeps the sequential loop. */
+  static final int CONFIGURED_THREADS = parseThreads(System.getProperty(PROPERTY));
+
+  private static final String REPEAT_SKIP_LINE =
+      "Pass loop skipped: fanout left the board an earlier pass loop with the same settings"
+          + " started on.";
+
+  private final RoutingJob job;
+  private final List<RoutingFallback.Strategy> strategies;
+  private final List<AttemptJob> jobs = new ArrayList<>();
+  private final List<Future<Result>> futures = new ArrayList<>();
+  private final ThreadPoolExecutor pool;
+
+  private ParallelFallbackAttempts(
+      RoutingJob job, List<RoutingFallback.Strategy> strategies, int threads) {
+    this.job = job;
+    this.strategies = List.copyOf(strategies);
+    AtomicInteger counter = new AtomicInteger();
+    this.pool =
+        new ThreadPoolExecutor(
+            threads,
+            threads,
+            0L,
+            TimeUnit.MILLISECONDS,
+            new LinkedBlockingQueue<>(),
+            runnable -> {
+              Thread thread =
+                  new Thread(runnable, "routing-fallback-attempt-" + counter.incrementAndGet());
+              thread.setDaemon(true);
+              return thread;
+            });
+  }
+
+  /** Parses the property value; anything but a positive integer means 0. */
+  static int parseThreads(String value) {
+    if (value == null || value.isBlank()) {
+      return 0;
+    }
+    try {
+      return Math.max(0, Integer.parseInt(value.trim()));
+    } catch (NumberFormatException e) {
+      return 0;
+    }
+  }
+
+  /**
+   * Worker threads for a fallback with {@code alternatives} strategies: the requested count capped
+   * by {@code router.autorouter.max_threads} and the strategy count. Fewer than two means
+   * sequential (0).
+   */
+  static int effectiveThreads(int configured, RouterSettings settings, int alternatives) {
+    int threads = Math.min(configured, Math.min(settings.getAutorouterMaxThreads(), alternatives));
+    return threads >= 2 ? threads : 0;
+  }
+
+  /**
+   * Starts every alternative on {@code initialThreads} workers, in strategy order. The settings
+   * copies are made here, on the job thread, from the job's current settings.
+   */
+  static ParallelFallbackAttempts start(
+      RoutingJob job,
+      byte[] input,
+      List<RoutingFallback.Strategy> alternatives,
+      ClearanceBaseline inputBaseline,
+      Set<String> knownPassLoopStarts,
+      int initialThreads) {
+    ParallelFallbackAttempts workers =
+        new ParallelFallbackAttempts(job, alternatives, Math.max(1, initialThreads));
+    Set<String> known = Set.copyOf(knownPassLoopStarts);
+    for (RoutingFallback.Strategy strategy : alternatives) {
+      RouterSettings settings = job.routerSettings.clone();
+      strategy.apply(settings);
+      RouterSettings scoring = job.routerSettings.clone();
+      AttemptJob attemptJob = new AttemptJob(job, settings);
+      workers.jobs.add(attemptJob);
+      workers.futures.add(
+          workers.pool.submit(
+              () -> runDetached(attemptJob, input, strategy, scoring, inputBaseline, known)));
+    }
+    return workers;
+  }
+
+  /** Raises the worker count, for example once the job thread stops routing continuations. */
+  void setThreads(int threads) {
+    if (threads > this.pool.getMaximumPoolSize()) {
+      this.pool.setMaximumPoolSize(threads);
+      this.pool.setCorePoolSize(threads);
+    }
+  }
+
+  private static Result runDetached(
+      AttemptJob attemptJob,
+      byte[] input,
+      RoutingFallback.Strategy strategy,
+      RouterSettings scoring,
+      ClearanceBaseline inputBaseline,
+      Set<String> knownPassLoopStarts) {
+    BatchAutorouter router = null;
+    try {
+      RoutingBoard board = (RoutingBoard) BasicBoard.deserialize(input);
+      if (board.clearanceBaseline == null) {
+        board.clearanceBaseline = inputBaseline;
+      }
+      attemptJob.board = board;
+      RouterSettings settings = attemptJob.routerSettings;
+      boolean removeUnconnectedVias = !settings.isFanoutEnabled();
+      router = BatchAutorouter.createAttempt(attemptJob, board, settings, removeUnconnectedVias);
+      router.detachedAttempt = true;
+      if (strategy.fanoutOnly) {
+        router.setRepeatsPassLoop(
+            hash -> {
+              attemptJob.repeatCheckMark = attemptJob.lines.size();
+              return hash != null && knownPassLoopStarts.contains(hash);
+            });
+      }
+      router.runBatchLoop();
+      RoutingFallback.Outcome outcome =
+          RoutingFallback.Outcome.of(strategy.name, attemptJob.board, scoring);
+      ClearanceBaseline baseline =
+          RoutingFallback.captureClearance(attemptJob.board, outcome.violations);
+      return new Result(
+          new RoutingFallbackRunner.Attempt(outcome, attemptJob.board, router, baseline),
+          router,
+          null);
+    } catch (RuntimeException e) {
+      return new Result(null, router, e);
+    }
+  }
+
+  /**
+   * Waits for the attempt at {@code index}, replays its log lines through the job and returns it as
+   * the sequential loop would have: a fanout-only attempt whose post-fanout board is one of {@code
+   * passLoopStarts} counts as stopped after its fanout. Returns null for a failed attempt.
+   */
+  Taken take(int index, Map<String, RoutingFallback.Outcome> passLoopStarts) {
+    RoutingFallback.Strategy strategy = this.strategies.get(index);
+    AttemptJob attemptJob = this.jobs.get(index);
+    Result result = await(index);
+    BatchAutorouter router = result.router;
+    if (router != null) {
+      router.job = this.job;
+    }
+    String hash = router != null ? router.passLoopStartHash : null;
+    boolean ranRepeat =
+        router != null && router.lastStopReason == BatchAutorouter.StopReason.REPEATED;
+    boolean lateRepeat =
+        !ranRepeat
+            && strategy.fanoutOnly
+            && hash != null
+            && attemptJob.repeatCheckMark >= 0
+            && passLoopStarts.containsKey(hash);
+    if (lateRepeat) {
+      attemptJob.replay(this.job, attemptJob.repeatCheckMark);
+      this.job.logInfo(REPEAT_SKIP_LINE);
+    } else {
+      attemptJob.replay(this.job, attemptJob.lines.size());
+    }
+    if (result.failure != null && !lateRepeat) {
+      this.job.logError(
+          "Routing fallback attempt '" + strategy.name + "' failed and was discarded.",
+          result.failure);
+      return null;
+    }
+    copyPhaseMetrics(attemptJob, this.job);
+    boolean repeated = ranRepeat || lateRepeat;
+    RoutingFallbackRunner.Attempt attempt = result.attempt;
+    if (repeated) {
+      RoutingFallback.Outcome earlier = passLoopStarts.get(hash);
+      if (earlier != null) {
+        attempt =
+            new RoutingFallbackRunner.Attempt(
+                new RoutingFallback.Outcome(
+                    strategy.name,
+                    earlier.unrouted,
+                    earlier.newOrChanged,
+                    earlier.violations,
+                    earlier.score,
+                    earlier.designBlocked),
+                attempt != null ? attempt.board() : attemptJob.board,
+                router,
+                attempt != null ? attempt.baseline() : null);
+      } else if (attempt == null) {
+        return null;
+      }
+    }
+    return new Taken(attempt, repeated);
+  }
+
+  private Result await(int index) {
+    try {
+      return this.futures.get(index).get();
+    } catch (InterruptedException e) {
+      Thread.currentThread().interrupt();
+      return new Result(null, null, new IllegalStateException("interrupted", e));
+    } catch (ExecutionException e) {
+      if (e.getCause() instanceof Error error) {
+        throw error;
+      }
+      RuntimeException failure =
+          e.getCause() instanceof RuntimeException runtime
+              ? runtime
+              : new IllegalStateException(e.getCause());
+      return new Result(null, null, failure);
+    }
+  }
+
+  private static void copyPhaseMetrics(AttemptJob from, RoutingJob to) {
+    if (from.resultPhaseMetrics == null || to.resultPhaseMetrics == null) {
+      return;
+    }
+    if (from.resultPhaseMetrics.fanout.before != null) {
+      to.resultPhaseMetrics.fanout = from.resultPhaseMetrics.fanout;
+    }
+    if (from.resultPhaseMetrics.autorouter.before != null) {
+      to.resultPhaseMetrics.autorouter = from.resultPhaseMetrics.autorouter;
+    }
+  }
+
+  /** Stops attempts the fold did not take, and waits for the workers to finish. */
+  @Override
+  public void close() {
+    for (int i = 0; i < this.futures.size(); i++) {
+      if (!this.futures.get(i).isDone()) {
+        this.jobs.get(i).thread.requestStop();
+        this.futures.get(i).cancel(false);
+      }
+    }
+    this.pool.shutdown();
+    boolean interrupted = false;
+    while (true) {
+      try {
+        if (this.pool.awaitTermination(1, TimeUnit.SECONDS)) {
+          break;
+        }
+      } catch (InterruptedException e) {
+        interrupted = true;
+      }
+    }
+    if (interrupted) {
+      Thread.currentThread().interrupt();
+    }
+  }
+
+  /** An attempt as the fold sees it. */
+  record Taken(RoutingFallbackRunner.Attempt attempt, boolean repeated) {}
+
+  private record Result(
+      RoutingFallbackRunner.Attempt attempt, BatchAutorouter router, RuntimeException failure) {}
+
+  /** Log levels a worker attempt buffers. */
+  enum Level {
+    INFO,
+    WARNING,
+    ERROR,
+    DEBUG
+  }
+
+  /** One buffered log line. */
+  record Line(Level level, String message, Throwable error) {}
+
+  /**
+   * The job view a worker attempt routes through. Log lines are buffered for an ordered replay;
+   * stop and timeout requests of the real job reach the attempt through its stop flag.
+   */
+  static final class AttemptJob extends RoutingJob {
+    final List<Line> lines = new ArrayList<>();
+    volatile int repeatCheckMark = -1;
+
+    AttemptJob(RoutingJob parent, RouterSettings settings) {
+      this.name = parent.name;
+      this.shortName = parent.shortName;
+      this.routerSettings = settings;
+      this.timeoutAt = parent.timeoutAt;
+      this.resourceUsage = parent.resourceUsage;
+      this.stage = parent.stage;
+      this.state = parent.state;
+      this.thread = new AttemptStop(parent, this);
+    }
+
+    @Override
+    public void logInfo(String message) {
+      this.lines.add(new Line(Level.INFO, message, null));
+    }
+
+    @Override
+    public void logWarning(String message) {
+      this.lines.add(new Line(Level.WARNING, message, null));
+    }
+
+    @Override
+    public void logError(String message, Throwable ex) {
+      this.lines.add(new Line(Level.ERROR, message, ex));
+    }
+
+    @Override
+    public void logDebug(String message) {
+      this.lines.add(new Line(Level.DEBUG, message, null));
+    }
+
+    /** Replays the first {@code count} buffered lines through {@code target}. */
+    void replay(RoutingJob target, int count) {
+      int end = Math.min(count, this.lines.size());
+      for (int i = 0; i < end; i++) {
+        Line line = this.lines.get(i);
+        switch (line.level()) {
+          case INFO -> target.logInfo(line.message());
+          case WARNING -> target.logWarning(line.message());
+          case ERROR -> target.logError(line.message(), line.error());
+          case DEBUG -> target.logDebug(line.message());
+          default -> throw new IllegalStateException("unknown level " + line.level());
+        }
+      }
+    }
+  }
+
+  /**
+   * A worker attempt's own stop flag. The attempt's pass loop requests its own auto-router stop
+   * without touching the job thread; a stop of the job, or its timeout, also stops the attempt.
+   */
+  static final class AttemptStop extends StoppableThread {
+    private final RoutingJob parent;
+    private final RoutingJob attemptJob;
+
+    AttemptStop(RoutingJob parent, RoutingJob attemptJob) {
+      this.parent = parent;
+      this.attemptJob = attemptJob;
+    }
+
+    @Override
+    protected void threadAction() {
+      // Never started: this object only carries the attempt's stop state.
+    }
+
+    @Override
+    public boolean isStopRequested() {
+      return super.isStopRequested() || parentStopped();
+    }
+
+    @Override
+    public boolean isStopAutoRouterRequested() {
+      return super.isStopAutoRouterRequested() || parentStopped();
+    }
+
+    private boolean parentStopped() {
+      if (this.parent.state == RoutingJobState.TIMED_OUT
+          && this.attemptJob.state != RoutingJobState.TIMED_OUT) {
+        this.attemptJob.state = RoutingJobState.TIMED_OUT;
+      }
+      return this.parent.thread != null && this.parent.thread.isStopRequested();
+    }
+  }
+}
