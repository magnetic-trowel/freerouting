+package app.freerouting.autoroute.pipeline;
+
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertNull;
+
+import org.junit.jupiter.api.Test;
+
+/** Tests the pass-skip decision of experiment E13. */
+class BatchOptimizerEarlyExitTest {
+
+  @Test
+  void skipsAtTheClampedFloorWhenNoCandidateCanLiftIt() {
+    // Score clamped at 0 and no single candidate (nor all of them) can lift it.
+    assertNotNull(BatchOptimizer.skipDecision(0.0f, 0.0f, 0.0f, true, 0.0));
+    assertNotNull(BatchOptimizer.skipDecision(0.0f, 0.0f, 0.0f, false, 0.0));
+  }
+
+  @Test
+  void scoreRankedNeedsOneCandidateThatGainsOnItsOwn() {
+    // All candidates together could lift the floor, but none alone: score_ranked commits nothing.
+    assertNotNull(BatchOptimizer.skipDecision(0.0f, 0.0f, 12.0f, true, 0.0));
+    // The other selections may combine commits, so the pass runs.
+    assertNull(BatchOptimizer.skipDecision(0.0f, 0.0f, 12.0f, false, 0.0));
+  }
+
+  @Test
+  void runsWheneverACandidateMayImprove() {
+    assertNull(BatchOptimizer.skipDecision(700.0f, 700.5f, 900.0f, true, 0.0));
+    assertNull(BatchOptimizer.skipDecision(700.0f, 700.0f, 700.5f, false, 0.0));
+  }
+
+  @Test
+  void marginSkipsPassesWhoseWholeGainIsSmall() {
+    // 700 -> at most 710 is 1.43%: skipped with a 2.5% margin, run without a margin.
+    assertNotNull(BatchOptimizer.skipDecision(700.0f, 705.0f, 710.0f, true, 2.5));
+    assertNull(BatchOptimizer.skipDecision(700.0f, 705.0f, 710.0f, true, 0.0));
+    assertNull(BatchOptimizer.skipDecision(700.0f, 705.0f, 800.0f, true, 2.5));
+  }
+}
