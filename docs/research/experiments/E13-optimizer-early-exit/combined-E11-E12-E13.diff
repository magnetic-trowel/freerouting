@@ -0,0 +1,27 @@
+package app.freerouting.autoroute.pipeline;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+import org.junit.jupiter.api.Test;
+
+/** Tests the preferred-direction modes of experiment E12. */
+class BatchOptimizerPassPolicyTest {
+
+  @Test
+  void alternateIsTheCurrentBehaviour() {
+    for (int pass = 1; pass <= 6; pass++) {
+      assertEquals(pass % 2 != 0, BatchOptimizer.withPreferredDirections(pass, "alternate"));
+      // Unknown values fall back to the current behaviour.
+      assertEquals(pass % 2 != 0, BatchOptimizer.withPreferredDirections(pass, "bogus"));
+    }
+  }
+
+  @Test
+  void fixedAndInvertedModes() {
+    for (int pass = 1; pass <= 6; pass++) {
+      assertEquals(true, BatchOptimizer.withPreferredDirections(pass, "always"));
+      assertEquals(false, BatchOptimizer.withPreferredDirections(pass, "never"));
+      assertEquals(pass % 2 == 0, BatchOptimizer.withPreferredDirections(pass, "inverted"));
+    }
+  }
+}
