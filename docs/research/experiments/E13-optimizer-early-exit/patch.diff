+  private static final boolean EXP_EARLY_EXIT =
+      "gain_bound"
+          .equalsIgnoreCase(
+              System.getProperty("freerouting.exp.optimizer_early_exit", "off").trim());
+
+  /**
+   * Experiment E13: with a margin above 0, a pass is also skipped when the bound on the score of
+   * all its candidates together is at most this many percent above the current score. The pass
+   * then loses at most that much; 0 (default) skips only passes that cannot improve at all.
+   */
+  private static final double EXP_EARLY_EXIT_MARGIN_PERCENT =
+      Math.max(
+          0.0,
+          Double.parseDouble(
+              System.getProperty("freerouting.exp.optimizer_early_exit_margin", "0").trim()));
+
+  /**
+   * Returns why the pass cannot improve the lower-bound optimizer score, or null if it may. A
+   * candidate rips its connections and routes them again, so it can at best remove their trace
+   * length, vias and bends; the score with all of them removed bounds the candidate's score from
+   * above, because the score never rises with length, vias or bends. With {@code score_ranked} a
+   * pass commits only candidates that raise the score on their own, so the best single bound
+   * decides; the other selections may combine commits, so the bound of the union of all ripped
+   * items decides. The bound assumes that a candidate does not shorten items outside its ripped
+   * connections (the nested router may rip and re-route others; see the experiment README).
+   */
+  private String passSkipReason(
+      List<Integer> candidateItemIds, BoardStatistics stats, CommitSelection selection) {
+    double traceLengthMm = stats.traces.totalLengthMm != null ? stats.traces.totalLengthMm : 0.0;
+    int viaCount = stats.vias.totalCount != null ? stats.vias.totalCount : 0;
+    int bendCount = stats.bends.totalCount != null ? stats.bends.totalCount : 0;
+    Float current = stats.getOptimizerScore(job.routerSettings, traceLengthMm, viaCount, bendCount);
+    if (current == null) {
+      return null;
+    }
+    double boardUnitToMm = this.board.communication.boardUnitSize(Unit.MM);
+    float bestSingle = Float.NEGATIVE_INFINITY;
+    Set<Item> union = new TreeSet<>();
+    for (int itemId : candidateItemIds) {
+      Item item = this.board.getItem(itemId);
+      if (item == null || item.hasIgnoredNets()) {
+        continue;
+      }
+      Set<Item> ripped = rippedConnectionsOf(item);
+      union.addAll(ripped);
